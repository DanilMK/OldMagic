{
  "type": "old_magic:toggle",
  "delay": 4,
  "onEnd": {
    "type": "old_magic:mob_effect",
    "amplifier": -1,
    "duration": -1,
    "effect": "minecraft:levitation",
    "show_particle": true,
    "target": "entity_target"
  },
  "onStart": {
    "type": "old_magic:list",
    "action_list": [
      {
        "type": "old_magic:resave_target",
        "cast_to": "old_magic:entity",
        "get_target_name": "hit",
        "set_target_name": "entity_target"
      },
      {
        "type": "old_magic:mob_effect",
        "amplifier": 6,
        "duration": 16,
        "effect": "minecraft:levitation",
        "show_particle": true,
        "target": "entity_target"
      },
      {
        "type": "old_magic:sound",
        "target": "entity_target",
        "template": {
          "minVolume": 1.0,
          "pitch": 1.3,
          "position": [
            0.0,
            0.0,
            0.0
          ],
          "sound": "minecraft:entity.allay.ambient_without_item",
          "volume": 0.5
        }
      }
    ]
  },
  "onTick": {
    "type": "old_magic:list",
    "action_list": [
      {
        "type": "old_magic:particle",
        "particleTemplate": {
          "appearing": {
            "type": "solid"
          },
          "centerOffset": [
            0.0,
            0.0,
            0.0
          ],
          "count": 10,
          "move": {
            "moveRule": "from_center",
            "randomness": 0.1,
            "speed": 0.2
          },
          "particle": {
            "type": "minecraft:cloud"
          },
          "size": [
            0.5,
            0.5,
            0.5
          ]
        },
        "target": "entity_target"
      },
      {
        "type": "old_magic:sound",
        "target": "entity_target",
        "template": {
          "minVolume": 1.0,
          "pitch": 0.4,
          "position": [
            0.0,
            0.0,
            0.0
          ],
          "sound": "minecraft:entity.breeze.idle_ground",
          "volume": 0.1
        }
      },
      {
        "type": "old_magic:list",
        "action_list": [
          {
            "type": "old_magic:find_surface",
            "filter": {
              "type": "minecraft:any_of",
              "predicates": [
                {
                  "type": "minecraft:solid"
                },
                {
                  "type": "minecraft:matching_blocks",
                  "blocks": [
                    "minecraft:water",
                    "minecraft:lava"
                  ]
                }
              ]
            },
            "range": 4.0,
            "surface": "surface",
            "target": "entity_target"
          },
          {
            "type": "old_magic:mob_effect",
            "amplifier": 3,
            "duration": 4,
            "effect": "minecraft:levitation",
            "show_particle": true,
            "target": "entity_target"
          }
        ],
        "handle_status": "chain"
      },
      {
        "type": "old_magic:list",
        "action_list": [
          {
            "type": "old_magic:add_to_list",
            "list": "entities",
            "target": "entity_target"
          },
          {
            "type": "old_magic:target_by_nearby_entities",
            "center_position_target": "caster",
            "mode": "subtract",
            "range": 8.0,
            "set_previous_target": "previous_blocks",
            "shape": "sphere"
          },
          {
            "type": "old_magic:for_each_entity_target",
            "action": {
              "type": "old_magic:move_entity_to_position",
              "ignore_knockback_resistance": true,
              "positionTarget": "caster",
              "power": 0.05
            },
            "combine_amount": 0,
            "delay": 0
          }
        ],
        "handle_status": "chain"
      }
    ]
  }
}